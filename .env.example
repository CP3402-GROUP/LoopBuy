WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me
WORDPRESS_DB_ROOT_PASSWORD=change-root-me
WORDPRESS_DEBUG=1

# Separate Go backend database (local-development defaults only).
BACKEND_DB_HOST=backend-db
BACKEND_DB_PORT=3306
BACKEND_DB_NAME=loopbuy_backend
BACKEND_DB_USER=loopbuy
BACKEND_DB_PASSWORD=change-backend-db-me
BACKEND_DB_ROOT_PASSWORD=change-backend-root-me

API_PORT=8090
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Shared only by WordPress and Go. Generate one random value of at least 32
# characters. It may be empty for local development, but deployment requires it.
BFF_SHARED_SECRET=

# Marketplace identity. The client ID is public and is also passed to WordPress;
# the client secret and Resend key are available only to the Go API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:8080/wp-json/loopbuy/v1/auth/google/callback,https://loopbuy.store/wp-json/loopbuy/v1/auth/google/callback
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM="LoopBuy <auth@loopbuy.store>"
RESEND_MAX_EMAILS_PER_HOUR=100
EMAIL_VERIFICATION_URL=http://localhost:8080/login/
EMAIL_VERIFICATION_TTL=24h

# Listing photos are stored on the API server, never on third-party image hosts.
# Compose owns MEDIA_STORAGE_ROOT and DEMO_MEDIA_SOURCE_DIR mount paths.
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_MAX_UPLOAD_BYTES=8388608
DEMO_SEED_ENABLED=true

# OpenAI is used only for embeddings. Never expose this key to WordPress/JS.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_REQUESTS_PER_HOUR=300
OPENAI_MAX_REQUESTS_PER_USER_DAY=20

# Internal password shared only by the local API and Qdrant containers.
# Keep it non-empty and private; it is unrelated to the Qwen provider key.
QDRANT_API_KEY=replace-qdrant-local-key
QDRANT_COLLECTION=loopbuy_listings_v1
QDRANT_VECTOR_NAME=listing_text_v1

# Qwen 3.5 Flash via Alibaba Model Studio (International/Singapore by default).
# For the normal setup, this is the only Qwen value you need to fill in.
QWEN_API_KEY=
# Optional regional/model overrides:
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.5-flash
QWEN_MAX_REQUESTS_PER_HOUR=100
QWEN_MAX_REQUESTS_PER_USER_DAY=10

AI_CHAT_FALLBACK_ENABLED=true
OUTBOX_POLL_INTERVAL=2s

# Optional host-only diagnostics. These are used only with compose.debug.yaml.
BACKEND_DB_EXPOSE_PORT=3307
QDRANT_PORT=6333
